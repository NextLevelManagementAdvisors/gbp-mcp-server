{
  "name": "gbp-mcp-server",
  "version": "0.2.0",
  "description": "Google Business Profile MCP server — full surface (reviews, posts, Q&A, media, insights, attributes). Forked from satheeshds/gbp-review-agent.",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "gbp-mcp-server": "./build/index.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jmdurant/gbp-mcp-server.git"
  },
  "scripts": {
    "build": "tsc",
    "start": "node build/index.js",
    "start:mock": "cross-env NODE_ENV=development ENABLE_MOCK_MODE=true node build/index.js",
    "auth": "node authenticate.js",
    "dev": "tsx src/index.ts",
    "test": "npm run build && node build/test/runTests.js",
    "test:mock": "npm run build && node build/test/runTests.js --mock",
    "test:dev": "tsx src/test/runTests.ts",
    "test:client": "node test-client.js",
    "quick-test": "node quick-test.js",
    "setup:vscode": "node setup-vscode-copilot.js",
    "logs": "node monitor-logs.js",
    "logs:debug": "cross-env LOG_LEVEL=debug node monitor-logs.js",
    "lint": "eslint src/**/*.ts",
    "clean": "rm -rf build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "google-business",
    "google-business-profile",
    "gbp",
    "local-seo",
    "reviews",
    "posts",
    "qanda",
    "insights",
    "ai",
    "llm"
  ],
  "author": "Dr. James DuRant",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "googleapis": "^128.0.0",
    "node-fetch": "^3.3.2",
    "open": "^10.0.0",
    "zod": "^4.2.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@modelcontextprotocol/core": "2.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "cross-env": "^10.1.0",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0"
  },
  "files": [
    "build"
  ],
  "engines": {
    "node": ">=20.0.0"
  }
}
